{
  "manifest_version": 3,
  "name": "Canvas Local",
  "description": "A focused Canvas workspace with private local assignments and exact personal deadlines.",
  "version": "0.1.37",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Canvas Local settings",
    "default_popup": "options.html"
  },
  "options_page": "options.html",
  "key": ""
}
